# CMake output and local presets.
/build/
/build-*/
/CMakeUserPresets.json

# Generated results; keep the output directory in the repository.
/results/*
!/results/.gitkeep

# Files accidentally generated by an in-source CMake invocation.
/CMakeCache.txt
/CMakeFiles/
/Testing/
/Makefile
/build.ninja
/.ninja_deps
/.ninja_log
/cmake_install.cmake
/install_manifest.txt
/CTestTestfile.cmake
/DartConfiguration.tcl
/compile_commands.json

# Compiled objects and binaries.
*.o
*.a
*.so
*.so.*

# Local Python environment and caches.
.venv/
venv/
__pycache__/
*.py[cod]

# Local IDE, editor, and OS files.
*.swp
*.swo
*~

# Output of a direct run against the supplied example configuration.
/examples/riemann/c.csv
/examples/riemann/f_x.csv
/examples/riemann/f_t.csv
/examples/riemann/f_xt/
/examples/riemann/plots/
